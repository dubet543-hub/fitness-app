PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@solidcore.com
ADMIN_PASSWORD=SolidCore@2024
CORS_ORIGINS=http://localhost:3000

# Razorpay (payments) — live credentials go in the real .env / Render env, never in git
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Google/Apple federated sign-in — see SOCIAL_SIGN_IN.md
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Email OTP sign-in — SMTP creds used to send the one-time code.
# Gmail: use an App Password, not your normal password, with smtp.gmail.com:587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-address@gmail.com
