PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@solidcore.com
ADMIN_PASSWORD=SolidCore@2024
CORS_ORIGINS=http://localhost:3000

# Razorpay (payments, Android) — live credentials go in the real .env / Render env, never in git
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Apple In-App Purchase (payments, iOS) — presence of this flags Apple IAP
# as configured (utils/appstore.js verifies StoreKit transactions against
# Apple's own signature, not this value — set it to anything non-empty).
APPLE_IAP_SHARED_SECRET=configured

# Apple's numeric App Store Connect id for this app (App Store Connect → App
# Information → Apple ID). Only needed once the app is live in production —
# without it, production purchases can't be verified yet, which is fine
# pre-launch since only sandbox/TestFlight purchases exist.
APPLE_APP_STORE_ID=

# Google/Apple federated sign-in — see SOCIAL_SIGN_IN.md
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Email OTP sign-in — sent via Resend's HTTPS API (not SMTP: many hosts,
# including Render, block outbound SMTP ports). Get a key at resend.com;
# MAIL_FROM must be on a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=otp@solidcoreats.com
